Table users {
  id integer [primary key]
  name text
  token varchar(32) [unique]
  advice text [note: 'nullable — Result Page Advice, generated once']
  created_at timestamp
  updated_at timestamp
}

Table love_languages {
  id integer [primary key]
  name varchar
  description text
  created_at timestamp
  updated_at timestamp
}

Table statements {
  id integer [primary key]
  love_language_id integer [ref: > love_languages.id]
  body text
  created_at timestamp
  updated_at timestamp
}

Table answers {
  id integer [primary key]
  user_id integer [ref: > users.id]
  statement_id integer [ref: > statements.id]
  value tinyint [note: 'Likert 1-5, database CHECK constraint']
  created_at timestamp
  updated_at timestamp

  Index (user_id, statement_id) [unique]
}

Table results {
  id integer [primary key]
  user_id integer [ref: > users.id]
  love_language_id integer [ref: > love_languages.id]
  value float [note: 'average Likert score']
  created_at timestamp
  updated_at timestamp

  Index (user_id, love_language_id) [unique]
}

Table feedback {
  id integer [primary key]
  user_id integer [ref: > users.id, note: 'cascade delete, unique — one Feedback per Participant']
  message text
  created_at timestamp
  updated_at timestamp

  Index (user_id) [unique]
}

Table comparisons {
  id integer [primary key]
  initiator_id integer [ref: > users.id, note: 'cascade delete — Initiating Participant']
  partner_id integer [ref: > users.id, note: 'cascade delete — Partner']
  token varchar(32) [unique, note: 'Comparison Token']
  advice text [note: 'nullable — Comparison Advice, generated once']
  created_at timestamp
  updated_at timestamp

  Index (initiator_id, partner_id) [unique, note: 'ordered pair identifies the Comparison; reverse order is distinct']
}
