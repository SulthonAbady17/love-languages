{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "lerd": {
            "command": ["lerd", "mcp"],
            "enabled": true,
            "type": "local"
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        }
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "vendor/**",
            "storage/framework/**",
            "storage/logs/**",
            "bootstrap/cache/**",
            "public/storage/**"
        ]
    },
    "permission": {
        "edit": {
            ".env": "deny",
            "storage/*.key": "deny"
        }
    }
}
