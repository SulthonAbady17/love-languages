{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Love Language Assessment Statements",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["love_language", "description", "statements"],
    "properties": {
      "love_language": {
        "type": "string",
        "description": "Name of the love language in Bahasa Indonesia"
      },
      "description": {
        "type": "string",
        "description": "Short description of the love language in Bahasa Indonesia"
      },
      "statements": {
        "type": "array",
        "description": "Five declarative statements for the love language",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}
